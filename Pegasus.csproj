<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Pegasus</RootNamespace>
  </PropertyGroup>
  <!-- Yarn Spinner for Godot (vendored addon, MIT): pulls YarnSpinner + compiler from NuGet. -->
  <Import Project="addons/YarnSpinner-Godot/YarnSpinner-Godot.props" />
  <ItemGroup>
    <!-- Unit tests live in their own project. -->
    <Compile Remove="tests/**" />
  </ItemGroup>
</Project>
