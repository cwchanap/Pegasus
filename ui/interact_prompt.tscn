[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/InteractPrompt.cs" id="1_prompt"]

[node name="InteractPrompt" type="PanelContainer" node_paths=PackedStringArray("VerbLabel")]
mouse_filter = 2
theme_type_variation = &"PromptPill"
script = ExtResource("1_prompt")
VerbLabel = NodePath("Row/Verb")

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 10

[node name="Key" type="Label" parent="Row"]
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"KeyCapLight"
text = "E"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Verb" type="Label" parent="Row"]
layout_mode = 2
theme_type_variation = &"PromptLabel"
text = "Examine"
vertical_alignment = 1
