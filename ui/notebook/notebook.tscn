[gd_scene format=3]

[ext_resource type="Script" path="res://ui/notebook/Notebook.cs" id="1_notebook"]
[ext_resource type="PackedScene" path="res://ui/notebook/clue_entry.tscn" id="2_entry"]

[node name="Notebook" type="VBoxContainer"]
size_flags_vertical = 3
theme_override_constants/separation = 16
script = ExtResource("1_notebook")
Entry = ExtResource("2_entry")

[node name="Caption" type="Label" parent="."]
layout_mode = 2
theme_type_variation = &"MenuCaption"
text = "NOTEBOOK"

[node name="Empty" type="Label" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(1, 0)
layout_mode = 2
theme_type_variation = &"MenuMuted"
text = "What you find is written here."
autowrap_mode = 3

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3
follow_focus = true
horizontal_scroll_mode = 0

[node name="Entries" type="VBoxContainer" parent="Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10
