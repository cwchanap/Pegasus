[gd_scene format=3]

[ext_resource type="Script" path="res://ui/title/Title.cs" id="1_title"]
[ext_resource type="PackedScene" path="res://ui/settings/settings_panel.tscn" id="2_settings"]
[ext_resource type="Texture2D" path="res://content/art/ui/title.png" id="3_art"]
[ext_resource type="Texture2D" path="res://content/art/ui/logo.png" id="4_logo"]

[node name="Title" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_title")

[node name="Art" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
texture = ExtResource("3_art")
expand_mode = 1
stretch_mode = 6

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = -1
anchor_right = 0.4
anchor_bottom = 1.0
grow_vertical = 2

[node name="Col" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Logo" type="TextureRect" parent="Center/Col"]
custom_minimum_size = Vector2(440, 111)
layout_mode = 2
texture = ExtResource("4_logo")
expand_mode = 1
stretch_mode = 5

[node name="Tagline" type="Label" parent="Center/Col"]
layout_mode = 2
theme_type_variation = &"MenuMuted"
text = "Summer in Osaka. Snow at three in the morning."
horizontal_alignment = 1

[node name="Gap" type="Control" parent="Center/Col"]
custom_minimum_size = Vector2(0, 36)
layout_mode = 2

[node name="Buttons" type="VBoxContainer" parent="Center/Col"]
unique_name_in_owner = true
layout_mode = 2
